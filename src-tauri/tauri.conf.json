{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Binance P2P Manager",
  "version": "1.0.1",
  "identifier": "com.binance.p2p.manager",
  "build": {
    "beforeDevCommand": "npm run fe:dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run fe:build",
    "frontendDist": "../fe/build"
  },
  "app": {
    "windows": [
      {
        "title": "Binance P2P Manager",
        "width": 1200,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Binance P2P Tools",
    "copyright": "Copyright © 2025",
    "shortDescription": "Quản lý giao dịch Binance P2P",
    "longDescription": "Ứng dụng quản lý và theo dõi các giao dịch Binance P2P với tính năng đồng bộ tự động và hiển thị chi tiết thanh toán."
  }
}
